{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=VideoTubeDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "FFmpeg": {
    "Enabled": true,
    "FfmpegPath": "C:\\ffmpeg\\ffmpeg.exe",
    "FfprobePath": "C:\\ffmpeg\\ffprobe.exe",
    "ThumbnailExtractionArgs": "-i \"{input}\" -vf \"select='gt(scene,0.4)'\" -vframes 1 \"{output}\""
  },
  "VideoUpload": {
    "MaxFileSizeBytes": 5368709120,
    "AllowedExtensions": [".mp4", ".avi", ".mov", ".mkv", ".flv", ".wmv", ".webm"],
    "AllowedMimeTypes": ["video/mp4", "video/x-msvideo", "video/quicktime", "video/x-matroska", "video/x-flv", "video/x-ms-wmv", "video/webm"],
    "StoragePath": "videos",
    "ThumbnailPath": "thumbnails",
    "ThumbnailFormat": "jpg"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
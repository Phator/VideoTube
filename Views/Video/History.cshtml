@model IEnumerable<VideoTube.Models.Video>
@using VideoTube.Helpers

@{
    bool masked = MaskHelper.IsMasked(Context);
}

<h2 class="mb-4">Watch History</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No videos watched yet.
    </div>
}
else
{
    <div class="row">

        @foreach (var video in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow-sm h-100">

                    <!-- Thumbnail -->
                    <a asp-action="Watch"
                       asp-route-id="@video.Id"
                       class="thumbnail-wrapper">

                        <img src="/thumbnails/@video.ThumbnailFileName"
                             class="card-img-top"
                             alt="@(masked ? "Hidden Thumbnail" : video.Title)"
                             style="height: 180px; object-fit: cover; @(masked ? "filter: blur(50px);" : "")" />

                    </a>

                    <div class="card-body">

                        <!-- Title -->
                        <h5 class="card-title">
                            @(masked ? "Video Title Hidden" : video.Title)
                        </h5>

                        <!-- Duration -->
                        <p class="text-muted mb-2">
                            Duration: @(masked ? "--:--" : video.Duration)
                        </p>

                        <a asp-action="Watch"
                           asp-route-id="@video.Id"
                           class="btn btn-primary">
                            Watch Again
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}

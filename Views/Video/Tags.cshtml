@model List<VideoTube.Models.Tag>

<h2 class="mb-4">Browse Tags</h2>

@if (Model == null || !Model.Any())
{
    <p>No tags found.</p>
}
else
{
    <div class="d-flex flex-wrap gap-2">

        @foreach (var tag in Model)
        {
            <a asp-action="Tag"
               asp-route-name="@tag.Name"
               class="badge bg-primary p-2"
               style="font-size: 1rem;">
                @tag.Name
            </a>
        }

    </div>
}

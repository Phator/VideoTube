@model IEnumerable<VideoTube.Models.Video>
@using VideoTube.Helpers

@{
    bool masked = MaskHelper.IsMasked(Context);
}

<h2 class="mb-4">My Favorites</h2>

<div class="row">

@foreach (var video in Model)
{
    <div class="col-md-4 mb-4">

        <div class="card shadow-sm h-100 video-card">

            <!-- Thumbnail + Play Overlay -->
            <a asp-action="Watch"
               asp-route-id="@video.Id"
               class="thumbnail-wrapper">

                <img src="/thumbnails/@video.ThumbnailFileName"
                     class="card-img-top"
                     alt="@(masked ? "Hidden Thumbnail" : video.Title)"
                     style="height: 180px; object-fit: cover; @(masked ? "filter: blur(50px);" : "")" />

                <div class="play-overlay">
                    <i class="bi bi-play-circle-fill play-icon"></i>
                </div>

            </a>

            <div class="card-body">

                <!-- Title -->
                <h5 class="card-title">
                    @(masked ? "Video Title Hidden" : video.Title)
                </h5>

            </div>

        </div>

    </div>
}

</div>

<style>
    .thumbnail-wrapper {
        position: relative;
        display: block;
    }

    .play-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0;
        transition: 0.25s ease;
    }

    .play-icon {
        font-size: 64px;
        color: white;
        text-shadow: 0 0 10px black;
    }

    .thumbnail-wrapper:hover .play-overlay {
        opacity: 1;
    }

    .thumbnail-wrapper:hover img {
        filter: brightness(70%);
    }
</style>

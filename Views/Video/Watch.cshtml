@model VideoTube.Models.Video

<div class="row">

    <!-- Main Video Section -->
    <div class="col-md-8">

        <!-- Title -->
        <h2 class="mb-2">@Model.Title</h2>

        <!-- Metadata -->
        <div class="text-muted mb-3">
            @if (Model.Category != null)
            {
                <span>@Model.Category.Name</span>
                <span class="mx-2">•</span>
            }

            <span>@Model.Duration</span>
            <span class="mx-2">•</span>
            <span>@Model.Views Views</span>
        </div>

        <!-- Video Player -->
        <video id="videoPlayer"
               width="100%"
               controls
               class="mb-4">
            <source src="/videos/@Model.FileName" type="video/mp4" />
            Your browser does not support HTML5 video.
        </video>

        <!-- Description -->
        <p class="lead">@Model.Description</p>

<!-- Action Buttons -->
<div class="mt-4 d-flex gap-2">

    <button id="favoriteBtn"
            class="btn @(ViewBag.IsFavorited ? "btn-success" : "btn-outline-warning")"
            onclick="toggleFavorite(@Model.Id)">
        @(ViewBag.IsFavorited ? "❤️ Favorited" : "⭐ Add to Favorites")
    </button>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        ✏️ Edit
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        🗑️ Delete
    </a>

    @if (User.IsInRole("Admin"))
    {
        <form asp-action="GenerateSmartThumbnails" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-warning">
                🧠 Smart Thumbnails
            </button>
        </form>
    }

</div>

        @Html.AntiForgeryToken()

    </div>

    <!-- Related Videos -->
    <div class="col-md-4">

        <h4 class="mb-3">Related Videos</h4>

        @foreach (var video in ViewBag.RelatedVideos)
        {
            <a asp-action="Watch"
               asp-route-id="@video.Id"
               class="text-decoration-none text-dark">

<div class="card mb-3 shadow-sm">

    <div class="thumbnail-wrapper position-relative">

        @if ((DateTime.Now - video.UploadDate).TotalDays <= 3)
        {
            <div class="new-ribbon">NEW</div>
        }

        <img src="/thumbnails/@video.ThumbnailFileName"
             class="card-img-top"
             alt="@video.Title"
             style="height: 150px; object-fit: cover;" />
    </div>

                    <div class="card-body py-2">
                        <h6 class="mb-1">@video.Title</h6>
                        <small class="text-muted">
                            @video.Duration • @video.Views Views
                        </small>
                    </div>

                </div>

            </a>
        }

    </div>

</div>

<script>
    const video = document.getElementById("videoPlayer");
    const savedPosition = @(ViewBag.Progress ?? 0);

    video.addEventListener("loadedmetadata", () => {
        if (savedPosition > 0) {
            video.currentTime = savedPosition;
        }
    });

    setInterval(() => {
        if (!video.paused) {
            fetch('/Video/SaveProgress', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    videoId: @Model.Id,
                    currentSeconds: Math.floor(video.currentTime)
                })
            });
        }
    }, 10000);

    function toggleFavorite(videoId) {
        fetch('/Video/ToggleFavorite', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ id: videoId })
        })
        .then(response => response.json())
        .then(data => {
            const btn = document.getElementById('favoriteBtn');

            if (data.favorited) {
                btn.classList.remove('btn-outline-warning');
                btn.classList.add('btn-success');
                btn.innerHTML = '❤️ Favorited';
            } else {
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-warning');
                btn.innerHTML = '⭐ Add to Favorites';
            }
        });
    }
</script>

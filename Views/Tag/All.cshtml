@model List<VideoTube.Models.Tag>

<h2>All Tags</h2>

@if (!Model.Any())
{
    <p>No tags found.</p>
}
else
{
    foreach (var tag in Model)
    {
        <a asp-controller="TagController"
           asp-action="Name"
           asp-route-name="@tag.Name"
           class="badge bg-secondary me-1">
            @tag.Name
        </a>
    }
}

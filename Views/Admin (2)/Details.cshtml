@model VideoTube.Models.UserWithRolesViewModel

<h2>User Details</h2>

<div class="card p-3">
    <p><strong>Email:</strong> @Model.User.Email</p>
    <p><strong>Status:</strong>
        @if (Model.User.IsDisabled)
        {
            <span class="badge bg-danger">Disabled</span>
        }
        else
        {
            <span class="badge bg-success">Active</span>
        }
    </p>

    <p><strong>Roles:</strong>
        @foreach (var role in Model.Roles)
        {
            <span class="badge bg-primary me-1">@role</span>
        }
    </p>

    <form asp-action="Enable" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.User.Id" />
        <button class="btn btn-success">Approve User</button>
    </form>
</div>

<a asp-action="Dashboard" class="btn btn-secondary mt-3">Back</a>

@model List<Microsoft.AspNetCore.Identity.IdentityRole>

<h2 class="mb-4">Manage Roles</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Role ID</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.Id</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Dashboard" class="btn btn-secondary mt-3">Back</a>

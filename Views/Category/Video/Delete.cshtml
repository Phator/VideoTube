@model VideoTube.Models.Video
@using VideoTube.Helpers

@{
    bool masked = MaskHelper.IsMasked(Context);
}

<h2>Delete Video</h2>

<div class="alert alert-warning">

    <strong>Warning:</strong>

    Are you sure you want to delete:

    <strong>
        @(masked ? "Video Title Hidden" : Model.Title)
    </strong>?

</div>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    <button type="submit"
            class="btn btn-danger">
        Yes, Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@model List<VideoTube.Models.ActivityLog>

<h2>User Activity Logs</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Time</th>
            <th>Email</th>
            <th>Action</th>
            <th>Details</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Timestamp.ToLocalTime()</td>
                <td>@log.Email</td>
                <td>@log.Action</td>
                <td>@log.Details</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Dashboard" class="btn btn-secondary mt-3">Back</a>

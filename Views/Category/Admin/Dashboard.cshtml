@model VideoTube.Models.AdminDashboardViewModel

<div class="container mt-4">

    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row">

        <!-- Left Column: Stats + Analytics -->
        <div class="col-md-8">

            <!-- Platform Statistics -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    Platform Statistics
                </div>
                <div class="card-body">

                    <p><strong>Total Videos:</strong> @Model.TotalVideos</p>
                    <p><strong>Total Users:</strong> @Model.TotalUsers</p>
                    <p><strong>Total Views:</strong> @Model.TotalViews</p>

                    <p><strong>Total Duration:</strong>
                        @TimeSpan.FromSeconds(Model.TotalDuration).ToString(@"hh\:mm\:ss")
                    </p>

                    <p><strong>Video Storage:</strong> @Model.VideoStorageMB.ToString("0.00") MB</p>
                    <p><strong>Thumbnail Storage:</strong> @Model.ThumbnailStorageMB.ToString("0.00") MB</p>

                </div>
            </div>

            <!-- Highlights -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-success text-white">
                    Highlights
                </div>
                <div class="card-body">

                    <p><strong>Most Viewed:</strong>
                        @Model.MostViewed?.Title (@Model.MostViewed?.Views views)
                    </p>

                    <p><strong>Newest Video:</strong>
                        @Model.NewestVideo?.Title (@Model.NewestVideo?.UploadDate.ToString("MM/dd/yyyy"))
                    </p>

                </div>
            </div>

            <h3 class="mt-4 mb-3">Analytics</h3>

            <!-- Upload Trend -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-info text-white">
                    Video Upload Trend
                </div>
                <div class="card-body">
                    <canvas id="uploadChart"></canvas>
                </div>
            </div>

            <!-- Category Distribution -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-secondary text-white">
                    Category Distribution
                </div>
                <div class="card-body">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>

            <!-- Storage Usage -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-dark text-white">
                    Storage Usage
                </div>
                <div class="card-body">
                    <canvas id="storageChart"></canvas>
                </div>
            </div>

        </div>

        <!-- Right Column: Tools + Pending Approval -->
        <div class="col-md-4">

            <!-- Admin Tools -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    Admin Tools
                </div>
                <div class="card-body">

                    <form asp-action="RebuildDurations" method="post">
                        <button class="btn btn-warning w-100 mb-2">
                            <i class="bi bi-clock-history me-1"></i>
                            Rebuild All Durations
                        </button>
                    </form>

                </div>
            </div>

            <!-- Pending Approval -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-danger text-white">
                    Pending Approval
                </div>

                <div class="card-body">

                    @if (Model.PendingUsers.Any())
                    {
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>User ID</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var user in Model.PendingUsers)
                                {
                                    <tr>
                                        <td>@user.Email</td>
                                        <td>@user.Id</td>
                                        <td>
                                            <form asp-action="Enable" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button class="btn btn-success btn-sm">
                                                    Approve
                                                </button>
                                            </form>

                                            <a asp-action="Details"
                                               asp-route-id="@user.Id"
                                               class="btn btn-primary btn-sm ms-1">
                                                Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No users awaiting approval.</p>
                    }

                </div>
            </div>

            <!-- Role Tools -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    Role Tools
                </div>

                <div class="card-body">

                    <p class="text-muted mb-2">Assign special roles to users:</p>

                    <a asp-action="Users" class="btn btn-info w-100 mb-2">
                        Manage Users
                    </a>

                    <a asp-action="Roles" class="btn btn-secondary w-100">
                        Manage Roles
                    </a>

                </div>
            </div>

            <!-- ⭐ NEW: Activity Logs Panel -->
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    Activity Logs
                </div>

                <div class="card-body">
                    <p class="text-muted mb-2">View recent user and admin actions:</p>

                    <a asp-action="ActivityLogs" class="btn btn-dark w-100">
                        View Activity Logs
                    </a>
                </div>
            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Upload Trend Chart
    new Chart(document.getElementById('uploadChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UploadLabels)),
            datasets: [{
                label: 'Uploads',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UploadCounts)),
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13,110,253,0.2)',
                tension: 0.3
            }]
        }
    });

    // Category Distribution Chart
    new Chart(document.getElementById('categoryChart'), {
        type: 'pie',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCounts)),
                backgroundColor: [
                    '#0d6efd', '#198754', '#dc3545', '#ffc107', '#6f42c1',
                    '#20c997', '#fd7e14', '#0dcaf0'
                ]
            }]
        }
    });

    // Storage Usage Chart
    new Chart(document.getElementById('storageChart'), {
        type: 'bar',
        data: {
            labels: ['Videos (MB)', 'Thumbnails (MB)'],
            datasets: [{
                label: 'Storage',
                data: [@Model.VideoStorageMB, @Model.ThumbnailStorageMB],
                backgroundColor: ['#198754', '#6c757d']
            }]
        }
    });
</script>

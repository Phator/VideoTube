@model EditThumbnailViewModel
@using VideoTube.Helpers

@{
    bool masked = MaskHelper.IsMasked(Context);
}

<div class="container mt-4">

    <h2 class="mb-4">Edit Thumbnail</h2>

    <!-- Current Thumbnail Preview -->
    <div class="card shadow-sm mb-4" style="max-width: 420px;">
        <div class="card-header bg-dark text-white">
            Current Thumbnail
        </div>

        <img src="/thumbnails/@Model.CurrentThumbnail"
             class="card-img-top"
             alt="@(masked ? "Hidden Thumbnail" : Model.CurrentThumbnail)"
             style="@(masked ? "filter: blur(50px);" : "")" />
    </div>

    <form asp-action="EditThumbnail"
          method="post"
          enctype="multipart/form-data"
          class="card p-4 shadow-sm">

        <input type="hidden" asp-for="VideoId" />

        <h4 class="mb-3">Choose a New Thumbnail</h4>

        <!-- Timestamp Selector -->
        <div class="mb-3">
            <label asp-for="TimestampSeconds" class="form-label fw-bold">
                Capture at Timestamp (seconds)
            </label>

            <input asp-for="TimestampSeconds"
                   type="number"
                   min="0"
                   class="form-control"
                   placeholder="Enter seconds (e.g., 20, 60, 120)" />

            <small class="text-muted">
                This will capture a frame at the given timestamp.
            </small>
        </div>

        <hr />

        <!-- Custom Upload -->
        <div class="mb-3">
            <label asp-for="CustomThumbnail" class="form-label fw-bold">
                Upload Custom Thumbnail
            </label>

            <input asp-for="CustomThumbnail"
                   type="file"
                   accept="image/*"
                   class="form-control" />

            <small class="text-muted">
                JPG or PNG recommended.
            </small>
        </div>

        <hr />

        <!-- Scene Detect Option -->
        <div class="mb-3">
            <p class="fw-bold mb-1">Scene Detect (Default)</p>
            <small class="text-muted">
                If no timestamp or custom image is provided, the thumbnail will be auto‑generated using scene detection.
            </small>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">
                Update Thumbnail
            </button>

            <a asp-action="Watch"
               asp-route-id="@Model.VideoId"
               class="btn btn-secondary">
                Back to Video
            </a>
        </div>

    </form>

</div>

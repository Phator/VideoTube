@model IEnumerable<VideoTube.Models.Video>
@using VideoTube.Helpers

@{
    bool masked = MaskHelper.IsMasked(Context);
}

<!-- Search Bar -->
<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search videos..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</form>

<div class="row">

    <!-- Main Video Grid -->
    <div class="col-md-9">
        <div class="row">

            @foreach (var video in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card video-card shadow-sm">

                        <!-- Thumbnail with Play Overlay -->
                        <a asp-action="Watch"
                           asp-route-id="@video.Id"
                           class="thumbnail-wrapper">

                            <img src="/thumbnails/@video.ThumbnailFileName"
                                 class="card-img-top"
                                 alt="@(masked ? "Hidden Thumbnail" : video.Title)"
                                 style="height:200px; object-fit:cover; @(masked ? "filter: blur(50px);" : "")" />

                            <div class="play-overlay">
                                <i class="bi bi-play-circle-fill play-icon"></i>
                            </div>

                        </a>

                        <div class="card-body">

                            <!-- Title -->
                            <h5 class="card-title">
                                @(masked ? "Video Title Hidden" : video.Title)
                            </h5>

                            <!-- Category -->
                            @if (video.Category != null)
                            {
                                <p class="text-muted">
                                    @(masked ? "Category Hidden" : video.Category.Name)
                                </p>
                            }

                            <!-- Duration -->
                            <p class="card-text">
                                Duration: @(masked ? "--:--" : video.Duration)
                            </p>

                            <!-- Views -->
                            <p class="card-text">
                                Views: @(masked ? "Hidden" : video.Views)
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-md-3">
        <div class="sticky-sidebar">

            <!-- Admin Tools (Only for Admins) -->
            @if (User.IsInRole("Admin"))
            {
                <div class="card mb-4">
                    <div class="card-header bg-warning text-dark">
                        🛠️ Tools
                    </div>

                    <div class="card-body">
                        <form asp-action="RebuildDurations" method="post">
                            <button class="btn btn-warning w-100 mb-2">
                                <i class="bi bi-clock-history me-1"></i>
                                Rebuild Durations
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Most Viewed -->
            <div class="card mb-4">
                <div class="card-header bg-danger text-white">
                    🔥 Most Viewed
                </div>

                <div class="list-group list-group-flush">
                    @foreach (var video in ViewBag.PopularVideos)
                    {
                        <a asp-action="Watch"
                           asp-route-id="@video.Id"
                           class="list-group-item list-group-item-action">

                            <strong>
                                @(masked ? "Video Title Hidden" : video.Title)
                            </strong>
                            <br />
                            <small>
                                @(masked ? "Hidden Views" : $"{video.Views} Views")
                            </small>

                        </a>
                    }
                </div>
            </div>

            <!-- Recently Added -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    🆕 Recently Added
                </div>

                <div class="list-group list-group-flush">
                    @foreach (var video in ViewBag.RecentVideos)
                    {
                        <a asp-action="Watch"
                           asp-route-id="@video.Id"
                           class="list-group-item list-group-item-action">

                            <strong>
                                @(masked ? "Video Title Hidden" : video.Title)
                            </strong>
                            <br />
                            <small>
                                @(masked ? "Hidden Date" : video.UploadDate.ToString("MM/dd/yyyy"))
                            </small>

                        </a>
                    }
                </div>
            </div>

        </div>
    </div>

</div>

<!-- Overlay CSS -->
<style>
    .thumbnail-wrapper {
        position: relative;
        display: block;
    }

    .play-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0;
        transition: 0.25s ease;
    }

    .play-icon {
        font-size: 64px;
        color: white;
        text-shadow: 0 0 10px black;
    }

    .thumbnail-wrapper:hover .play-overlay {
        opacity: 1;
    }

    .thumbnail-wrapper:hover img {
        filter: brightness(70%);
    }
</style>
